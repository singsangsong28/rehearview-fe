# 개발 서버(npm run dev)에서는 없어도 기본값(localhost:4000)으로 동작한다.
# Vercel 에서는 Environment Variables 에 OCI 백엔드의 HTTPS 주소를 넣는다. 끝에 슬래시나 /api 는 붙이지 않는다.
BACKEND_URL="http://localhost:4000"
# 구글 애널리틱스 측정 ID(G-로 시작). 비워 두면 추적 코드를 넣지 않는다. 값을 바꾸면 다시 빌드·배포해야 반영된다.
NEXT_PUBLIC_GA_ID=
# Cloudflare Turnstile 사이트 키(공개 값). 비우면 로그인 봇 검증 위젯을 그리지 않는다. 백엔드의 TURNSTILE_SECRET_KEY와 함께 넣고, 값을 바꾸면 다시 빌드·배포해야 반영된다.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
